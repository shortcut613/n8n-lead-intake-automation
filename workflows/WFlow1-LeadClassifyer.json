    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('If').item.json; // change 'If' if your validation node has a different name\nconst raw = $json.choices?.[0]?.message?.content ?? null;\n\nlet classification = null;\nlet reasoning = null;\nlet parse_error = null;\n\ntry {\n  const parsed = JSON.parse(raw);\n  classification = String(parsed.classification ?? '').trim().toUpperCase();\n  reasoning = parsed.reasoning ?? null;\n\n  if (!['HOT', 'WARM', 'COLD'].includes(classification)) {\n    throw new Error(`Invalid classification value: ${parsed.classification}`);\n  }\n  if (!reasoning) {\n    throw new Error('Missing reasoning field');\n  }\n} catch (e) {\n  parse_error = e.message;\n  classification = null;\n}\n\nreturn {\n  json: {\n    ...lead,\n    classification,\n    reasoning,\n    parse_error,\n    raw_llm_output: raw,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -192
      ],
      "id": "9741708d-1fa3-4eb6-8a3e-8b5458763429",
      "name": "Parse Classification"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n    const data = item.json.body || {};\n    \n    const name = data.full_name || data.lead_name || (data.contact && data.contact.name) || null;\n    const email = data.email_address || data.contact_email || null;\n    \n    let phone = data.phone_number || (data.contact && data.contact.phone) || null;\n    if (phone === \"\") phone = null;\n\n    const source = data.utm_source || data.channel || data.referral_partner || data.source || \"unknown\";\n    const message = data.notes || data.message_body || data.comments || null;\n    \n    return {\n        json: {\n            name: name,\n            email: email,\n            phone: phone,\n            source: source,\n            message: message,\n            timestamp: new Date().toISOString()\n        }\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
