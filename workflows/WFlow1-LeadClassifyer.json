        "jsonBody": "={{ (() => {\n  const l = $('Parse Classification').item.json;\n  return JSON.stringify({\n    text: (l.classification === \"HOT\" ? \":fire:\" : l.classification === \"WARM\" ? \":sunny:\" : \":snowflake:\") +\n          \" *New lead: \" + l.classification + \"*\" +\n          \"\\n*Name:* \" + l.name +\n          \"\\n*Email:* \" + (l.email ?? \"n/a\") +\n          \"\\n*Phone:* \" + (l.phone ?? \"n/a\") +\n          \"\\n*Source:* \" + l.source +\n          \"\\n*Message:* \" + (l.message ?? \"(none)\") +\n          \"\\n*AI reasoning:* \" + l.reasoning\n  });\n})() }}",
