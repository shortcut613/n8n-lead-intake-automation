    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $('Has Email?').item.json;\nconst err = $json.error ?? {};\nconst code = String($json.details?.httpCode ?? err.code ?? err.httpCode ?? 'unknown');\n\nlet reason = 'Unexpected error calling AbstractAPI';\nif (code === '401') reason = 'Missing or invalid API key';\nelse if (code === '422') reason = 'Free-tier quota exhausted';\nelse if (code === '429') reason = 'Rate limited';\nelse if (code.startsWith('EAI') || code === 'ENOTFOUND') reason = 'Network/DNS failure reaching AbstractAPI';\n\nreturn {\n  json: {\n    failed_step: 'Email verification (AbstractAPI)',\n    error_detail: reason + ' | code: ' + code + ' | ' + (err.message ?? 'no message'),\n    raw_payload: row,\n    timestamp: new Date().toISOString(),\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
